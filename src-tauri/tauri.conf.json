{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocumentBench",
  "version": "0.1.0",
  "identifier": "com.documentbench.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocumentBench",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/app-icon.png"],
    "resources": ["resources/pdfium.dll"]
  }
}
